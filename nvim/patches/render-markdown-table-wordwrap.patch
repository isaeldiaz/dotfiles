+---@field row_ranges render.md.Range[][][]
+
+---Split display segments into visual-width ranges, breaking at word boundaries
+---when possible and falling back to a hard break for words longer than a line.
+---Ranges are visual-width offsets so they can be fed to `Line:sub`, which slices
+---on display width and preserves per-segment highlight groups.
+---@param segments render.md.mark.Line
+---@param width integer
+---@return render.md.Range[]
+local function wrap_ranges(segments, width)
+    local text = ''
+    for _, seg in ipairs(segments) do
+        text = text .. seg[1]
+    end
+    local total = str.width(text)
+    if width <= 0 or total <= width then
+        return { { 1, math.max(width, total, 1) } }
+    end
+
+    -- Per-character widths so CJK / emoji break on character boundaries.
+    local chars, starts = {}, {}
+    local pos = 0
+    for _, ch in ipairs(vim.fn.split(text, '\\zs')) do
+        chars[#chars + 1] = ch
+        starts[#chars] = pos + 1
+        pos = pos + str.width(ch)
+    end
+    local function stop_of(k)
+        return (k < #chars) and (starts[k + 1] - 1) or total
+    end
+
+    local ranges = {} ---@type render.md.Range[]
+    local first = 1
+    while first <= #chars do
+        -- Last character that still fits on this visual line.
+        local last = first
+        while last < #chars and stop_of(last + 1) - starts[first] + 1 <= width do
+            last = last + 1
+        end
+        if last >= #chars then
+            ranges[#ranges + 1] = { starts[first], total }
+            break
+        end
+        -- Prefer breaking after the last space that fits.
+        local brk = nil
+        for k = last + 1, first + 1, -1 do
+            if chars[k] == ' ' then
+                brk = k
+                break
+            end
+        end
+        if brk then
+            ranges[#ranges + 1] = { starts[first], starts[brk] - 1 }
+            first = brk + 1
+            while first <= #chars and chars[first] == ' ' do
+                first = first + 1
+            end
+        else
+            ranges[#ranges + 1] = { starts[first], stop_of(last) }
+            first = last + 1
+        end
+    end
+    return ranges
+end
 
